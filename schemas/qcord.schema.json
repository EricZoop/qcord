{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qcord encrypted message",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Qcord encrypted message",
      "description": "ML-KEM ciphertext, AES-GCM encrypted message, and optional canonical ML-DSA signature components. New files are signed; old blank or missing signatures remain readable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qcord_version",
        "kem",
        "encrypted_message"
      ],
      "properties": {
        "qcord_version": {
          "const": 6
        },
        "encrypted_message": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nonce_base64",
            "ciphertext_base64",
            "authentication_tag_base64"
          ],
          "properties": {
            "nonce_base64": {
              "type": "string",
              "minLength": 16,
              "maxLength": 16,
              "pattern": "^[A-Za-z0-9+/]{16}$"
            },
            "ciphertext_base64": {
              "type": "string",
              "maxLength": 1048576,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$"
            },
            "authentication_tag_base64": {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "pattern": "^[A-Za-z0-9+/]{21}[AQgw]==$"
            }
          }
        },
        "signature_sigma": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "c_tilde",
                "z",
                "h"
              ],
              "description": "FIPS 204 Algorithms 26-27: sigma encodes the challenge seed c_tilde, response vector z, and hint vector h. Qcord placeholders only.",
              "properties": {
                "c_tilde": {
                  "type": "string",
                  "const": "",
                  "description": "Blank challenge seed (not the challenge polynomial c)."
                },
                "z": {
                  "type": "array",
                  "maxItems": 0,
                  "description": "Blank response vector."
                },
                "h": {
                  "type": "array",
                  "maxItems": 0,
                  "description": "Blank hint vector."
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "c_tilde",
                "z",
                "h"
              ],
              "properties": {
                "c_tilde": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]+={0,2}$"
                },
                "z": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 256,
                    "maxItems": 256,
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "h": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "maxItems": 80,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    }
                  }
                }
              }
            }
          ]
        },
        "kem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "u",
            "v"
          ],
          "properties": {
            "u": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "array",
                "minItems": 256,
                "maxItems": 256,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2047
                }
              }
            },
            "v": {
              "type": "array",
              "minItems": 256,
              "maxItems": 256,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "u": {
                    "type": "array",
                    "maxItems": 3
                  }
                }
              },
              "then": {
                "properties": {
                  "u": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "maximum": 1023
                      }
                    }
                  },
                  "v": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "maximum": 15
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kem": {
                "type": "object",
                "properties": {
                  "u": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              },
              "signature_sigma": {
                "type": "object",
                "properties": {
                  "c_tilde": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "signature_sigma": {
                "type": "object",
                "properties": {
                  "c_tilde": {
                    "type": "string",
                    "minLength": 44,
                    "maxLength": 44
                  },
                  "z": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -131071,
                        "maximum": 131072
                      }
                    }
                  },
                  "h": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "array",
                      "maxItems": 80
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kem": {
                "type": "object",
                "properties": {
                  "u": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3
                  }
                }
              },
              "signature_sigma": {
                "type": "object",
                "properties": {
                  "c_tilde": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "signature_sigma": {
                "type": "object",
                "properties": {
                  "c_tilde": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "z": {
                    "type": "array",
                    "minItems": 5,
                    "maxItems": 5,
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -524287,
                        "maximum": 524288
                      }
                    }
                  },
                  "h": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "items": {
                      "type": "array",
                      "maxItems": 55
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kem": {
                "type": "object",
                "properties": {
                  "u": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4
                  }
                }
              },
              "signature_sigma": {
                "type": "object",
                "properties": {
                  "c_tilde": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "signature_sigma": {
                "type": "object",
                "properties": {
                  "c_tilde": {
                    "type": "string",
                    "minLength": 88,
                    "maxLength": 88
                  },
                  "z": {
                    "type": "array",
                    "minItems": 7,
                    "maxItems": 7,
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -524287,
                        "maximum": 524288
                      }
                    }
                  },
                  "h": {
                    "type": "array",
                    "minItems": 8,
                    "maxItems": 8,
                    "items": {
                      "type": "array",
                      "maxItems": 75
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Qcord encrypted message",
      "description": "One ML-KEM-512, ML-KEM-768, or ML-KEM-1024 ciphertext (compressed u/v) and one AES-256-GCM message encrypted with its K. Qcord transport format; AES-GCM is outside FIPS 203. Blank signature_sigma fields reserve a future ML-DSA signature; signing and verification are not implemented. Older files may omit the placeholder.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qcord_version",
        "u",
        "v",
        "encrypted_message"
      ],
      "properties": {
        "qcord_version": {
          "const": 5
        },
        "u": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 256,
            "maxItems": 256,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2047
            }
          }
        },
        "v": {
          "type": "array",
          "minItems": 256,
          "maxItems": 256,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          }
        },
        "encrypted_message": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nonce_base64",
            "ciphertext_base64",
            "authentication_tag_base64"
          ],
          "properties": {
            "nonce_base64": {
              "type": "string",
              "minLength": 16,
              "maxLength": 16,
              "pattern": "^[A-Za-z0-9+/]{16}$"
            },
            "ciphertext_base64": {
              "type": "string",
              "maxLength": 1048576,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$"
            },
            "authentication_tag_base64": {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "pattern": "^[A-Za-z0-9+/]{21}[AQgw]==$"
            }
          }
        },
        "signature_sigma": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "c_tilde",
            "z",
            "h"
          ],
          "description": "FIPS 204 Algorithms 26-27: sigma encodes the challenge seed c_tilde, response vector z, and hint vector h. Qcord placeholders only.",
          "properties": {
            "c_tilde": {
              "type": "string",
              "const": "",
              "description": "Blank challenge seed (not the challenge polynomial c)."
            },
            "z": {
              "type": "array",
              "maxItems": 0,
              "description": "Blank response vector."
            },
            "h": {
              "type": "array",
              "maxItems": 0,
              "description": "Blank hint vector."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "u": {
                "type": "array",
                "maxItems": 3
              }
            }
          },
          "then": {
            "properties": {
              "u": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "maximum": 1023
                  }
                }
              },
              "v": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "maximum": 15
                }
              }
            }
          }
        }
      ]
    }
  ]
