{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qcord encrypted message",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Qcord encrypted message",
      "description": "An ML-KEM ciphertext grouped under kem, an AES-GCM encrypted message, and a reserved ML-DSA signature.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qcord_version",
        "kem",
        "encrypted_message"
      ],
      "properties": {
        "qcord_version": {
          "const": 6
        },
        "encrypted_message": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nonce_base64",
            "ciphertext_base64",
            "authentication_tag_base64"
          ],
          "properties": {
            "nonce_base64": {
              "type": "string",
              "minLength": 16,
              "maxLength": 16,
              "pattern": "^[A-Za-z0-9+/]{16}$"
            },
            "ciphertext_base64": {
              "type": "string",
              "maxLength": 1048576,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$"
            },
            "authentication_tag_base64": {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "pattern": "^[A-Za-z0-9+/]{21}[AQgw]==$"
            }
          }
        },
        "signature_sigma": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "c_tilde",
            "z",
            "h"
          ],
          "description": "FIPS 204 Algorithms 26-27: sigma encodes the challenge seed c_tilde, response vector z, and hint vector h. Qcord placeholders only.",
          "properties": {
            "c_tilde": {
              "type": "string",
              "const": "",
              "description": "Blank challenge seed (not the challenge polynomial c)."
            },
            "z": {
              "type": "array",
              "maxItems": 0,
              "description": "Blank response vector."
            },
            "h": {
              "type": "array",
              "maxItems": 0,
              "description": "Blank hint vector."
            }
          }
        },
        "kem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "u",
            "v"
          ],
          "properties": {
            "u": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "array",
                "minItems": 256,
                "maxItems": 256,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2047
                }
              }
            },
            "v": {
              "type": "array",
              "minItems": 256,
              "maxItems": 256,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "u": {
                    "type": "array",
                    "maxItems": 3
                  }
                }
              },
              "then": {
                "properties": {
                  "u": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "maximum": 1023
                      }
                    }
                  },
                  "v": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "maximum": 15
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Qcord encrypted message",
      "description": "One ML-KEM-512, ML-KEM-768, or ML-KEM-1024 ciphertext (compressed u/v) and one AES-256-GCM message encrypted with its K. Qcord transport format; AES-GCM is outside FIPS 203. Blank signature_sigma fields reserve a future ML-DSA signature; signing and verification are not implemented. Older files may omit the placeholder.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qcord_version",
        "u",
        "v",
        "encrypted_message"
      ],
      "properties": {
        "qcord_version": {
          "const": 5
        },
        "u": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 256,
            "maxItems": 256,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2047
            }
          }
        },
        "v": {
          "type": "array",
          "minItems": 256,
          "maxItems": 256,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          }
        },
        "encrypted_message": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nonce_base64",
            "ciphertext_base64",
            "authentication_tag_base64"
          ],
          "properties": {
            "nonce_base64": {
              "type": "string",
              "minLength": 16,
              "maxLength": 16,
              "pattern": "^[A-Za-z0-9+/]{16}$"
            },
            "ciphertext_base64": {
              "type": "string",
              "maxLength": 1048576,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$"
            },
            "authentication_tag_base64": {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "pattern": "^[A-Za-z0-9+/]{21}[AQgw]==$"
            }
          }
        },
        "signature_sigma": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "c_tilde",
            "z",
            "h"
          ],
          "description": "FIPS 204 Algorithms 26-27: sigma encodes the challenge seed c_tilde, response vector z, and hint vector h. Qcord placeholders only.",
          "properties": {
            "c_tilde": {
              "type": "string",
              "const": "",
              "description": "Blank challenge seed (not the challenge polynomial c)."
            },
            "z": {
              "type": "array",
              "maxItems": 0,
              "description": "Blank response vector."
            },
            "h": {
              "type": "array",
              "maxItems": 0,
              "description": "Blank hint vector."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "u": {
                "type": "array",
                "maxItems": 3
              }
            }
          },
          "then": {
            "properties": {
              "u": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "maximum": 1023
                  }
                }
              },
              "v": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "maximum": 15
                }
              }
            }
          }
        }
      ]
    }
  ]
}
