{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qcord local config",
  "description": "Toggle settings first, followed by each security level with encapsulation, decapsulation, signature public and signature private keys in order. Empty keys are generated when the level is first used.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "auto_encrypt",
    "auto_decrypt",
    "auto_verify",
    "save_receipts",
    "config_version",
    "key_sets",
    "recipients"
  ],
  "properties": {
    "auto_encrypt": {
      "type": "boolean",
      "default": false
    },
    "auto_decrypt": {
      "type": "boolean",
      "default": true
    },
    "auto_verify": {
      "type": "boolean",
      "default": false
    },
    "save_receipts": {
      "type": "boolean",
      "default": true
    },
    "config_version": {
      "const": 5
    },
    "key_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ml-kem-512",
        "ml-kem-768",
        "ml-kem-1024"
      ],
      "properties": {
        "ml-kem-512": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public_encaps",
            "private_decaps",
            "public_signature",
            "private_signature"
          ],
          "properties": {
            "public_encaps": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 1068,
                  "maxLength": 1068
                }
              ]
            },
            "private_decaps": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 2176,
                  "maxLength": 2176
                }
              ]
            },
            "public_signature": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 1752,
                  "maxLength": 1752
                }
              ]
            },
            "private_signature": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 3416,
                  "maxLength": 3416
                }
              ]
            }
          }
        },
        "ml-kem-768": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public_encaps",
            "private_decaps",
            "public_signature",
            "private_signature"
          ],
          "properties": {
            "public_encaps": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 1580,
                  "maxLength": 1580
                }
              ]
            },
            "private_decaps": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 3200,
                  "maxLength": 3200
                }
              ]
            },
            "public_signature": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 2604,
                  "maxLength": 2604
                }
              ]
            },
            "private_signature": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 5376,
                  "maxLength": 5376
                }
              ]
            }
          }
        },
        "ml-kem-1024": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public_encaps",
            "private_decaps",
            "public_signature",
            "private_signature"
          ],
          "properties": {
            "public_encaps": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 2092,
                  "maxLength": 2092
                }
              ]
            },
            "private_decaps": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 4224,
                  "maxLength": 4224
                }
              ]
            },
            "public_signature": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 3456,
                  "maxLength": 3456
                }
              ]
            },
            "private_signature": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "minLength": 6528,
                  "maxLength": 6528
                }
              ]
            }
          }
        }
      }
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "user_id",
          "public_encaps",
          "encapsulations"
        ],
        "properties": {
          "channel_id": {
            "$ref": "#/$defs/id"
          },
          "user_id": {
            "$ref": "#/$defs/id"
          },
          "public_encaps": {
            "$ref": "#/$defs/ek"
          },
          "encapsulations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_epoch",
                "k"
              ],
              "properties": {
                "message_epoch": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "k": {
                  "type": "string",
                  "minLength": 44,
                  "maxLength": 44,
                  "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
                }
              }
            }
          },
          "public_signature": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "ek": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "minLength": 1068,
          "maxLength": 1068
        },
        {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "minLength": 1580,
          "maxLength": 1580
        },
        {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "minLength": 2092,
          "maxLength": 2092
        }
      ]
    }
  }
}
