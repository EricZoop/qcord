{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qcord ML-KEM-768 local config",
  "description": "One local key pair and recipients. Raw Base64 keys. Each secret m belongs to one original encapsulation; never reuse it for a new exchange.",
  "type": "object", "additionalProperties": false,
  "required": ["config_version", "recipients"],
  "dependentRequired": {"public_encaps": ["private_decaps"], "private_decaps": ["public_encaps"]},
  "properties": {
    "config_version": {"const": 3},
    "auto_encrypt": {"type": "boolean", "default": false},
    "auto_decrypt": {"type": "boolean", "default": true},
    "public_encaps": {"$ref": "#/$defs/ek"},
    "private_decaps": {"type": "string", "minLength": 3200, "maxLength": 3200, "pattern": "^[A-Za-z0-9+/]{3200}$"},
    "recipients": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_id", "user_id", "public_encaps", "encapsulations"],
      "properties": {
        "channel_id": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/id"}, "public_encaps": {"$ref": "#/$defs/ek"},
        "encapsulations": {"type": "array", "uniqueItems": true, "items": {
          "type": "object", "additionalProperties": false, "required": ["m"],
          "properties": {"m": {"type": "string", "minLength": 44, "maxLength": 44, "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"}}
        }}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9]{1,20}$"},
    "ek": {"type": "string", "minLength": 1580, "maxLength": 1580, "pattern": "^[A-Za-z0-9+/]{1578}[AEIMQUYcgkosw048]=$"}
  }
}
